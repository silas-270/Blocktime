<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Blocktime"
        android:enableOnBackInvokedCallback="true">
<activity
            android:name=".CesiumGameActivity"
            android:theme="@style/Theme.CesiumTheme"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|fontScale|density|locale|layoutDirection|colorMode|fontWeightAdjustment"
            android:screenOrientation="portrait"
            android:exported="true">
            <meta-data
                android:name="android.app.lib_name"
                android:value="cesium_rs" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The adb-only flight hook: DUMP is held by the adb shell and by no ordinary app, and
             flightHookEnabled in app/build.gradle.kts switches it on or off. -->
        <receiver
            android:name=".data.dev.FlightHookReceiver"
            android:enabled="${flightHookEnabled}"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.silas270.blocktime.ADD_FLIGHTS" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
